{
  "name": "d3/datawizardtasks",
  "description": "Fantastic Spells and where to find them - Example exports and actions for the DataWizard /\n Phantastische Zaubersprüche und wo Sie zu finden sind - Beispielexporte und -aktionen für den DataWizard",
  "type": "oxideshop-module",
  "keywords": [
    "oxid",
    "modules",
    "eShop",
    "d3",
    "export",
    "DataWizard"
  ],
  "authors": [
    {
      "name": "D3 Data Development (Inh. Thomas Dartsch)",
      "email": "info@shopmodule.com",
      "homepage": "https://www.d3data.de",
      "role": "Owner"
    }
  ],
  "support": {
    "email": "support@shopmodule.com"
  },
  "homepage": "https://www.oxidmodule.com/",
  "license": [
    "GPL-3.0-or-later"
  ],
  "require": {
    "d3/datawizard": "^3.0"
  },
  "require-dev": {
    "d3/testingtools": "^1.3.0.1",
    "phpunit/phpunit": "^9.6.0",
    "infection/infection": "^0.26.16 || ^0.29.10 || ^0.32.7",
    "friendsofphp/php-cs-fixer": "^3.9"
  },
  "autoload": {
    "psr-4": {
      "D3\\DataWizardTasks\\": ""
    }
  },
  "extra": {
    "commands":{
      "php-cs-fixer": "XDEBUG_MODE=off ./vendor/bin/php-cs-fixer fix --config=vendor/d3/datawizardtasks/.ci-tools/.php-cs-fixer.php",
      "phpunit": "XDEBUG_MODE=coverage ./vendor/bin/phpunit --config=vendor/d3/datawizardtasks/.ci-tools/phpunit.xml --no-coverage",
      "phpunit-line-coverage": "XDEBUG_MODE=coverage ./vendor/bin/phpunit --config=vendor/d3/datawizardtasks/.ci-tools/ --coverage-html=reports/phpunit/datawizardtasks --coverage-clover=reports/phpunit/datawizardtasks/clover.xml",
      "phpunit-path-coverage": "XDEBUG_MODE=coverage ./vendor/bin/phpunit --config=vendor/d3/datawizardtasks/.ci-tools/ --coverage-html=--coverage-html=reports/phpunit/datawizardtasks --path-coverage",
      "infection": "XDEBUG_MODE=coverage ./vendor/bin/infection --configuration=vendor/d3/datawizardtasks/.ci-tools/infection.json --threads=1"
    }
  }
}
